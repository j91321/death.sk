// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
//
// Tool versions are pinned to match .github/workflows (Hugo, Go, Dart Sass).
// Update both places together.
{
	"name": "death.sk (Hugo)",
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.26.1"
		},
		"ghcr.io/devcontainers/features/hugo:1": {
			"version": "0.160.0",
			"extended": true
		}
	},

	"containerEnv": {
		"DART_SASS_VERSION": "1.99.0",
		"TZ": "Europe/Oslo"
	},

	// Hugo dev server: hugo server --bind 0.0.0.0
	"forwardPorts": [1313],
	"portsAttributes": {
		"1313": { "label": "Hugo", "onAutoForward": "openBrowser" }
	},

	// Theme is a git submodule; Dart Sass is needed to compile the theme's SCSS.
	"postCreateCommand": "git submodule update --init --recursive && bash .devcontainer/install-dart-sass.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"budparr.language-hugo-vscode",
				"tamasfe.even-better-toml"
			]
		}
	}
}
